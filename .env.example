# --- ОБЯЗАТЕЛЬНО ---
# Транскрипция/субтитры (references/transcribe_subs.py): Groq whisper-large-v3.
GROQ_API_KEY=gsk_...

# Дефолтный приём сырья (references/fetch.py) — БЕЗ авторизации (открытая ссылка),
# никаких env-переменных не требует.

# --- ОПЦИОНАЛЬНО (fallback) ---
# Только для references/drive_io.py (сервисный аккаунт): приватные Drive-папки или
# заливка готового файла >50 МБ обратно на Drive. По умолчанию НЕ нужны.
# Артём расшаривает папки на client_email сервисного аккаунта из этого JSON.
# GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account-key.json
# DRIVE_INPUT_FOLDER_ID=
# DRIVE_OUTPUT_FOLDER_ID=
